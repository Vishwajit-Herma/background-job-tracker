# Django Settings
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production-use-at-least-50-random-characters
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database
DATABASE_URL=postgresql://background_job_tracker_user:background_job_tracker_password@localhost:5432/background_job_tracker_db
# Redis
REDIS_URL=redis://localhost:6379/0


# Celery
CELERY_BROKER_URL=redis://localhost:6379/1


# Static and Media


# Email
# Dev uses the console backend unless EMAIL_HOST is set (docker compose sets it to Mailpit).
# Production defaults to SMTP; configure your provider:
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-smtp-user
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=background_job_tracker@example.com
SERVER_EMAIL=background_job_tracker@example.com



# OpenTelemetry (gRPC OTLP exporter, port 4317)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=background_job_tracker
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp








# Security
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False


# CORS (for frontend development)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging
LOG_LEVEL=INFO
